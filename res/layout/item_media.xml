<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp">

    <com.android.gallery3d.SquareImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tile_placeholder"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/video_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="6dp"
        android:background="@drawable/bg_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_w_play" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/fav_badge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="start|bottom"
        android:layout_margin="6dp"
        android:src="@drawable/ic_w_favorite" />

    <View
        android:id="@+id/select_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/select_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/bg_badge"
        android:padding="3dp"
        android:src="@drawable/ic_w_check"
        android:visibility="gone" />
</FrameLayout>
